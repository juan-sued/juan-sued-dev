# NEXT_PUBLIC_* values are exposed to browser bundles. Never place secrets here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side only. Keep real values in .env.local and Vercel; never commit them.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# Production requires both Turnstile keys. Never commit .env.local.
ADMIN_USER_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=
