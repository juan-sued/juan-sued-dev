# NEXT_PUBLIC_* values are exposed to browser bundles. Never place secrets here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Server-side only. Keep real values in .env.local and in the hosting provider; never commit them.
TURNSTILE_SECRET_KEY=

# Contact form delivery (Resend). Without these, dev logs the message instead of sending it
# and production rejects the request.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
